{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnotAI",
  "version": "0.1.1",
  "identifier": "br.com.anotai.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnotAI",
        "url": "index.html",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "create": false
      },
      {
        "label": "overlay",
        "title": "AnotAI overlay",
        "url": "overlay.html",
        "width": 360,
        "height": 72,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "AnotAI",
    "category": "Productivity",
    "shortDescription": "Ditado por voz com correção automática",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR", "English"]
      }
    },
    "resources": {
      "resources/ggml-silero-v6.2.0.bin": "ggml-silero-v6.2.0.bin"
    }
  }
}
